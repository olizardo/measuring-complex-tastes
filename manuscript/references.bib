  number = {3},
  eprint = {pdf/44127708.pdf},
  eprinttype = {jstor},
  pages = {28--32},
  issn = {0018-7259},
  abstract = {The most complete form of the sociological datum, after all, is the form in which the participant observer gathers it: An observation of some social event, the events which precede and follow it, and explanations of its meaning by participants and spectators, before, during, and after its occurrence. Such a datum gives us more information about the event under study than data gathered by any other sociological method. Participant observation can thus provide us with a yardstick against which to measure the completeness \dots}
