  month = may,
  journal = {Social networks},
  volume = {22},
  number = {1},
  pages = {65--72},
  issn = {0378-8733},
  doi = {10.1016/s0378-8733(00)00017-4},
  abstract = {Recently, Borgatti and Everett [Borgatti, S.P., Everett, M.G., 1997. Network analysis of 2-mode data. Social Networks 19, 243--269.] criticized correspondence analysis as a technique for analyzing two-mode network data. This paper argues that these criticisms are not justified and that correspondence analysis of such data can in fact yield considerable substantive insight. As in Borgatti and Everett, the familiar Davis et al. [Davis, A., Gardner, B.B., Gardner, M.R., 1941. Deep South: An Anthropological Study of Caste and Class, University of Chicago Press, Chicago, IL] Southern women data set is used to illustrate the technique.}
