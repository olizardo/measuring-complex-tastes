@article{joseph2015culture-2ba,
  title = {Culture, Networks, Twitter and Foursquare: {{Testing}} a Model of Cultural Conversion with Social Media Data},
  author = {Joseph, Kenneth and Carley, Kathleen},
  year = 2015,
  journal = {Proceedings of the International AAAI Conference on Web and Social Media},
  volume = {9},
  number = {1},
  pages = {626--629},
  issn = {2334-0770},
  abstract = {Social network research often takes the view that networks chiefly influence the spread of culture, with few reciprocal effects. While some network scholars have implied a coevolutionary relationship between the two, cultural sociologists have provided increasingly convincing evidence that it is in fact cultural preferences which mediate network structure, rather than the other way around. In the present work, we attempt to validate one such model of the conversion of cultural capital to network position. We use Twitter data to extract the ego networks of individuals and foursquare check-ins to understand their cultural preferences. Our results are indicative of the importance of considering sociological models in which culture influences network structure.},
  keywords = {culture and networks,foursquare,Twitter}
}

@book{joseph2017language-dbc,
  title = {Language, Mind and Body: A Conceptual History},
  author = {Joseph, John E},
  year = 2017,
  month = dec,
  publisher = {Cambridge University Press},
  abstract = {Where is language? Answers to this have attempted to 'incorporate' language in an 'extended mind', through cognition that is 'embodied', 'distributed', 'situated' or 'ecological'. Behind these concepts is a long history that this book is the first to trace. Extending across linguistics, philosophy, psychology and medicine, as well as literary and religious dimensions of the question of what language is, and where it is located, this book challenges mainstream, mind-based accounts of language. Looking at research from the Middle Ages to the present day, and exploring the work of a range of scholars from Aristotle and Galen to Merleau-Ponty and Chomsky, it assesses raging debates about whether mind and language are centred in heart or brain, brain or nervous-muscular system, and whether they are innate or learned, individual or social. This book will appeal to scholars and advanced students in historical linguistics, cognitive linguistics, language evolution and the philosophy of language.},
  isbn = {978-1-108-37821-5}
}

