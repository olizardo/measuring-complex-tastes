@article{bourdieu1974avenir-885,
  title = {Avenir de Classe et Causalit\'e Du Probable},
  author = {Bourdieu, Pierre},
  year = 1974,
  journal = {Revue fran\c caise de sociologie},
  volume = {15},
  number = {1},
  eprint = {pdf/3320261.pdf},
  eprinttype = {jstor},
  pages = {3--42},
  issn = {0035-2969},
  doi = {10.2307/3320261},
  abstract = {[Practices depend, not on the generically possible chances of profit available at a given moment to any agent whatsoever, but on the objective chances which his capital guarantees at a particular moment to a definite class of agents. Furthermore, in the cases considered herein, durable attitudes tend to anticipate these objective chances in very practical ways. More precisely, practices depend on the structure of the differential chances of profit which are open to this class, given the volume and nature of its capital, and consequently on the system of strategies that aims at maintaining or improving the position of this class in the social structure. /// Dependen las pr\'acticas econ\'omicas no de las posibilidades gen\'ericas de provecho que se ofrecieron en un momento definido del tiempo a un agente cualquiera, sino de las suertes objetivas que asegura su capital en un momento dado a una clase determinada de agentes y que, en los casos peculiares considerados aqu\'i, las disposiciones duraderas (habitus) tienden a anticipar pr\'acticamente; y de modo m\'as preciso dependen de la estructura de las posibilidades diferenciales de provecho que se ofrecen a esa clase en consideraci\'on al volumen y a la estructura de su capital y a la estructura del sistema de estrateg\'ia de reproducci\'on que emplea para mantener o mejorar su posici\'on en la estructura social. /// Die wirtschaftlichen Praktiken sind nicht von spezifischen Profitchancen abh\"angig, die zu einem bestimmten Zeitpunkt irgendeinem Agenten geboten werden, sondern von den objektiven Chancen, die sein Kapital zu einem gewissen Zeitpunkt einer bestimmten Agentenklasse sichert und die, bei den hier untersuchten Sonderf\"allen, die Dauerdispositionen (Habitus) praktisch zu antizipieren versuchen. Genauer gesagt sind diese Praktiken von der Struktur der differentiellen Profitchancen abh\"angig, die sich dieser Klasse bieten, aufgrund des Volumens und der Struktur ihres Kapitals und somit auch abh\"angig von der Systemstruktur der Revolutionsstrategien, die diese Klasse einsetzt, um ihre Stellung in der Sozialstruktur zu behaupten oder zu verbessern. /// \cyrchar\CYRP\cyrchar\cyrr\cyrchar\cyra\cyrchar\cyrk\cyrchar\cyrt\cyrchar\cyri\cyrchar\cyrk\cyrchar\cyra{} \cyrchar\cyrn\cyrchar\cyre{} \cyrchar\cyrz\cyrchar\cyra\cyrchar\cyrv\cyrchar\cyri\cyrchar\cyrs\cyrchar\cyri\cyrchar\cyrt{} \cyrchar\cyro\cyrchar\cyrt{} \cyrchar\cyrg\cyrchar\cyre\cyrchar\cyrn\cyrchar\cyre\cyrchar\cyrr\cyrchar\cyri\cyrchar\cyrch\cyrchar\cyre\cyrchar\cyrs\cyrchar\cyrk\cyrchar\cyri\cyrchar\cyrh{} \cyrchar\cyrsh\cyrchar\cyra\cyrchar\cyrn\cyrchar\cyrs{} \cyrchar\cyrp\cyrchar\cyrr\cyrchar\cyri\cyrchar\cyrb\cyrchar\cyrery\cyrchar\cyrl\cyrchar\cyri{} \cyrchar\cyrp\cyrchar\cyrr\cyrchar\cyre\cyrchar\cyrd\cyrchar\cyrs\cyrchar\cyrt\cyrchar\cyra\cyrchar\cyrv\cyrchar\cyrl\cyrchar\cyrya\cyrchar\cyryu\cyrchar\cyrshch\cyrchar\cyri\cyrchar\cyrh\cyrchar\cyrs\cyrchar\cyrya{} \cyrchar\cyrv{} \cyrchar\cyrk\cyrchar\cyra\cyrchar\cyrk\cyrchar\cyro\cyrchar\CYRISHRT{} \cyrchar\cyrt\cyrchar\cyro{} \cyrchar\cyrm\cyrchar\cyro\cyrchar\cyrm\cyrchar\cyre\cyrchar\cyrn\cyrchar\cyrt{} \cyrchar\cyrv\cyrchar\cyrr\cyrchar\cyre\cyrchar\cyrm\cyrchar\cyre\cyrchar\cyrn\cyrchar\cyri{} \cyrchar\cyrp\cyrchar\cyrr\cyrchar\cyri{} \cyrchar\cyrk\cyrchar\cyra\cyrchar\cyrk\cyrchar\cyro\cyrchar\cyrm{} \cyrchar\cyrt\cyrchar\cyro{} \cyrchar\cyra\cyrchar\cyrg\cyrchar\cyre\cyrchar\cyrn\cyrchar\cyrt\cyrchar\cyre, \cyrchar\cyra{} \cyrchar\cyro\cyrchar\cyrt{} \cyrchar\cyro\cyrchar\cyrb\cyrchar\cyrhrdsn\cyrchar\cyre\cyrchar\cyrk\cyrchar\cyrt\cyrchar\cyri\cyrchar\cyrv\cyrchar\cyrn\cyrchar\cyrery\cyrchar\cyrh{} \cyrchar\cyrsh\cyrchar\cyra\cyrchar\cyrn\cyrchar\cyrs, \cyrchar\cyrk\cyrchar\cyro\cyrchar\cyrt\cyrchar\cyro\cyrchar\cyrr\cyrchar\cyrery\cyrchar\cyre{} \cyrchar\cyrs\cyrchar\cyrv\cyrchar\cyro\cyrchar\CYRISHRT{} \cyrchar\cyrk\cyrchar\cyra\cyrchar\cyrp\cyrchar\cyri\cyrchar\cyrt\cyrchar\cyra\cyrchar\cyrl{} \cyrchar\cyro\cyrchar\cyrb\cyrchar\cyr