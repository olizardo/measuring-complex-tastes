@book{linton1936study-760,
  title = {The Study of Man},
  author = {Linton, Ralph},
  year = 1936,
  publisher = {Appleton-Century},
  address = {Oxford},
  abstract = {This book is an "introduction" in two respects: its broad scope and data provide a beginner student with the essentials of anthropology, and it summarizes the accomplishments and methodological inadequacies in that field. The book is not so arranged, but in reality deals with three groups of materials: (1) the first four chapters deal with human and racial origins and the significance of racial (both physical and mental) differences; (2) chapters 7-15 discuss the nature of society and the social and political systems within it; and (3) chapters 6 and 16-26 discuss the characteristic aspects of cultural composition and change. For illustrative facts the author has drawn upon his own field work on the Comanche, Marquesans and Tanala, which are included in an introductory textbook for the first time. Some of the analyses are original, such as the classification of cultural components, from the point of view of individual participation in group life, into universals, specialties and alternatives. Social and political groups are thoroughly discussed, whereas economic life, religion and art are given practically no importance. The problems of culture and cultural change are considered from the point of view of the "schools" of anthropology, the presence of which is regarded as a sign of the science's immaturity. The theories of the diffusionists, functionalists, etc., are impartially analyzed and their inadequacies indicated. Throughout the book, in the last few chapters particularly (on function, interests, orientations, and culture and personality), the need for a psychological approach to anthropology is emphasized. Bibliography and index. (PsycINFO Database Record (c) 2016 APA, all rights reserved)}
}

