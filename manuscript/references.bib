@book{katz1999how-63b,
  title = {How Emotions Work},
  author = {Katz, Jack},
  year = 1999,
  month = nov,
  publisher = {University of Chicago Press},
  abstract = {Many of the ways in which we express and react to emotions make very little sense. From the tears that mark both the best and worst moments in our lives to the rages sparked by the most trivial of traffic annoyances, emotions surprise us-they lead us to act in ways contrary to our better judgment, and they always seem to lie just beyond our control. In How Emotions Work, Jack Katz observes situations ranging from a criminal's interrogation-room breakdown to a child's temper tantrum, and offers new approaches to understanding our emotions, their sources, and the behavior they lead to, all with unprecedented clarity.},
