@incollection{dimaggio2011cultural-366,
  title = {Cultural Networks},
  booktitle = {The {{SAGE}} Handbook of Social Network Analysis},
  author = {DiMaggio, Paul},
  editor = {Scott", ["John and Carrington"], "Peter J},
  year = 2011,
