}

@article{strand2020sociology-b16,
  title = {Sociology and Philosophy in the {{United States}} since the Sixties: {{Death}} and Resurrection of a Folk Action Obstacle},
  author = {Strand, Michael},
  year = 2020,
  journal = {Theory and society},
