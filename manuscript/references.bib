@article{wierzbicka2015natural-1f3,
  title = {Natural Semantic Metalanguage},
  author = {Wierzbicka, Anna},
  year = 2015,
  month = apr,
  journal = {The international encyclopedia of language and},
  pages = {1--17},
  doi = {10.1002/9781118611463.wbielsi150},
  abstract = {The natural semantic metalanguage (NSM) is a minilanguage that is believed to correspond to the common core of all languages. It has come to light through wide-ranging cross-linguistic investigations pursued over more than three decades. It has a minilexicon of 65 semantic primes or ?atoms of meaning? (e.g., ?good? and ?bad,? ?do? and ?happen?) and 50 or so universal ?semantic molecules? (e.g., ?man,? ?woman,? and ?child?; ?fire? and ?water?) and a minigrammar. The NSM system was developed primarily as a linguistic theory aimed at identifying the ?language of thought? and the shared core of the lexicon and grammar of all natural languages, but it has been shown to have important practical applications in many areas, including cross-cultural communication and the pursuit of knowledge in the globalized world increasingly dominated by English.}
}

