@article{peterson1992understanding-ce3,
  title = {Understanding Audience Segmentation: {{From}} Elite and Mass to Omnivore and Univore},
  author = {Peterson, Richard A},
  year = 1992,
  month = aug,
  journal = {Poetics},
  volume = {21},
  number = {4},
  pages = {243--258},
  issn = {0304-422X},
  doi = {10.1016/0304-422x(92)90008-q},
  abstract = {The view of cultural stratification that places a discriminating and exclusive elite on the top and an undiscriminating mass on the bottom is questioned. Using a log-multiplicative model to simultaneously stratify occupational groups and music preferences, it is clear that while those in the upper occupational groups are more apt to like symphonic music and to engage in elite arts activities, they are also more apt to like a number of kinds of music and engage in a wide range of non-elite activities. At the same time, those in the lowest occupational groups tend to engage in few activities and to strongly like one single non-elite form of music. The results are interpreted as showing a shift from an elite-to-mass status hierarchy to an omnivore-to-univore status hierarchy.}
}

