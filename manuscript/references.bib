@article{loder2003inner-city-472,
  title = {Inner-City Youth Development Organizations: {{The}} Salience of Peer Ties among Early Adolescent Girls},
  author = {Loder, Tondra L and Hirsch, Barton J},
  year = 2003,
  month = jan,
  journal = {Applied developmental science},
  volume = {7},
  number = {1},
  pages = {2--12},
  issn = {1088-8691},
  doi = {10.1207/s1532480xads0701_1},
  abstract = {There has been little research on the importance of adolescent-peer relationships in urban youth-development organizations. Focusing on girls ages 10 years old and up at 4 inner-city Boys and Girls Clubs, this exploratory study employed multiple methods; including ethnography (N = 124), and especially, interview and sociometric techniques (n = 17) to examine the salience of peer ties. Findings reveal that compared to school and other neighborhood settings, the youth club is a powerful context for fostering close friendships. Having fun with friends is a key motivation for participation in youth clubs; the availability of activities that enable such interactions affects the implementation of psychoeducational programs. Despite close peer ties, widespread concerns were expressed about betrayal and duplicity. Implications for youth programming and staff development are discussed.}
}

