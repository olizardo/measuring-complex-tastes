@article{cornelissen2005beyond-769,
  title = {Beyond Compare: {{Metaphor}} in Organization Theory},
  author = {Cornelissen, Joep P},
  year = 2005,
  month = oct,
  journal = {AMRO},
  volume = {30},
  number = {4},
