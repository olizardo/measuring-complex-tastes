@book{hayek1952sensory-34f,
  title = {The Sensory Order: {{An}} Inquiry into the Foundations of Theoretical Psychology},
  author = {Hayek, F A},
  year = 1952,
  publisher = {University of Chicago Press},
  abstract = {The Sensory Order, first published in 1952, sets forth F. A. Hayek's classic theory of mind in which he describes the mental mechanism that classifies perceptions that cannot be accounted for by physical laws. Hayek's substantial contribution to theoretical psychology has been addressed in the work of Thomas Szasz, Gerald Edelman, and Joaquin Fuster. "A most encouraging example of a sustained attempt to bring together information, inference, and hypothesis in the several fields of biology, psychology, and philosophy."---Quarterly Review of Biology F. A. Hayek (1899-1992), recipient of the Medal of Freedom in 1991 and co-winner of the Nobel Memorial Prize in Economics in 1974, taught at the University of London, the University of Chicago, and the University of Freiburg.},
