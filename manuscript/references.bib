@article{lopes1999diffusion-1fa,
  title = {Diffusion and Syncretism: {{The}} Modern Jazz Tradition},
  author = {Lopes, Paul},
  year = 1999,
  journal = {The Annals of the American Academy of Political and Social Science},
  volume = {566},
  number = {1},
  pages = {25--36},
  issn = {0002-7162},
  doi = {10.1177/000271629956600103},
  abstract = {This article presents an analysis of the musical syncretism involved in the development of a modern jazz tradition in the United States in the first half of the twentieth century. It shows how a professional ethos among popular musicians during this period guided their reinterpretation and reinvention of folk, popular, and classical music practices in the creation of this music tradition. It further argues that this ethos led them, in their low-status positions as popular musicians, to affirm their legitimacy through the creation of a high-art aesthetic. In general, this study shows how the social context in the diffusion of jazz practices affected the transformation of these practices in value and form in this century.}
}

@article{lopes2002rise-c9d,
  title = {The Rise of a Jazz Art World},
  author = {Lopes, Paul},
  year = 2002,
  pages = {279--286},
  doi = {10.1017/cbo9780511489495.008},
  abstract = {This 2002 book presents a unique sociological vision of the evolution of jazz in the twentieth century. Analysing organizational structures and competing discourses in American music, Paul Lopes shows how musicians and others transformed the meaning and practice of jazz. Set against the distinct worlds of high art and popular art in America, the rise of a jazz art world is shown to be a unique movement - a socially diverse community struggling in various ways against cultural orthodoxy. Cultural politics in America is shown to be a dynamic, open, and often contradictory process of constant re-interpretation. This work is a compelling social history of American culture that incorporates various voices in jazz, including musicians, critics, collectors, producers and enthusiasts. Accessibly written and interdisciplinary in approach, it will be of great interest to scholars and students of sociology, cultural studies, social history, American studies, African-American studies, and jazz studies.}
}

@article{lópez-sintas2005from-bcb,
  title = {From Exclusive to Inclusive Elitists and Further: {{Twenty}} Years of Omnivorousness and Cultural Diversity in Arts Participation in the {{USA}}},
  author = {{L{\'o}pez-Sintas}, Jordi and {Katz-Gerro}, Tally},
  year = 2005,
  month = oct,
  journal = {Poetics},
  volume = {33},
  number = {5},
  pages = {299--319},
  issn = {0304-422X},
  doi = {10.1016/j.poetic.2005.10.004},
  abstract = {Research on cultural omnivorousness is expanded by examination of cultural participation and by anchoring omnivorousness alongside other patterns of cultural consumption in a comparative context over time in the USA. Between 1982 and 2002, at the aggregate level little change was found in cultural consumption of live performing arts, but patterns of attendance did change, with an increase in cultural differentiation. It was expressed in quasi-omnivorous and entertainment patterns that drew consumers away from more traditional highbrow consumption patterns. Increase in cultural differentiation was associated with rise in educational levels; this may reflect a link between the breadth of consumption patterns of the elite and their need for scale and synthesis in cultural knowledge.}
}

