  doi = {10.1093/oxfordhb/9780190251765.013.9},
  abstract = {This chapter focuses on the general principle of duality, which was originally introduced by Simmel as the intersection of social circles. In a seminal article, Breiger formalized Simmel's idea, showing how two-mode types of network data can be transformed into one-mode networks. This formal translation proved to be fundamental for social network analysis, which no longer needed data on who interacted with whom but could work with other types of data. In turn, it also proved fundamental for the analysis of how the social is structured in general, as many relations are dual (e.g. persons and groups, authors and articles, organizations and practices), and are thus susceptible to an analysis according to duality principles. The chapter locates the concept of duality within past and present sociology. It also discusses the use of duality in the analysis of culture as well as in affiliation networks. It closes with recent developments and future directions.},
  isbn = {978-0-19-025176-5},
  keywords = {affiliation networks,culture,duality,networks,Simmel,two-mode networks}
}

