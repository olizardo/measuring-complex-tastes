@incollection{basov2017duality-24b,
  title = {Duality beyond Dyads: {{Multiplex}} Patterning of Social Ties and Cultural Meanings},
  booktitle = {Structure, Content and Meaning of Organizational Networks},
  author = {Basov, Nikita and Brennecke, Julia},
  year = 2017,
