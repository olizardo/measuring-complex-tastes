@article{ereshefsky2018natural-698,
  title = {Natural Kinds, Mind Independence, and Defeasibility},
  author = {Ereshefsky, Marc},
  year = 2018,
  month = dec,
  journal = {Philosophy of science},
  volume = {85},
  number = {5},
  pages = {845--856},
  issn = {0031-8248},
  doi = {10.1086/699676},
  abstract = {A standard requirement on natural kinds is that they be mind independent. However, many kinds in the human and social sciences, even the natural sciences, depend on human thought. This article suggests that the mind independence requirement on natural kinds be replaced with the requirement that natural kind classifications be defeasible. The defeasibility requirement does not require that natural kinds be mind independent, so it does not exclude mind dependent scientific kinds from being natural kinds. Furthermore, the defeasibility requirement captures the idea that natural kind classifications are tools for investigating the empirical world.}
}

