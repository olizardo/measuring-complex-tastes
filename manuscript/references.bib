  year = 2025,
  pages = {359--370},
  issn = {1389-6903},
  doi = {10.1007/978-3-031-93042-3_23},
  abstract = {Culture is an important part of human interaction, and prior research has found that individuals are likely to acquire cultural preferences from their social networks but has not revealed how ego networks directly influence behavioral investment (e.g., money and time) in culture. Using a novel large national dataset, we correct this oversight and cast light on how inexpensive claims of appreciation for music translate (or not) into concrete behaviors necessary to consume that music. Our findings suggest that ego networks have significant influences on the consumption of and participation in music genres, but not on music preferences. While stated preferences now appear to be independent of network effects, actual consumption behavior remains subject to network influence.}
}

