@article{thornton2013tacit-c09,
  title = {Tacit Knowledge and Its Antonyms},
  author = {Thornton, Tim},
  year = 2013,
  month = oct,
  journal = {Philosophia Scientiae. Travaux d'Histoire des Sciences et de Philosophie},
  number = {17-3},
  pages = {93--106},
  issn = {1281-2463},
  doi = {10.4000/philosophiascientiae.890},
  abstract = {Harry Collins's Tacit and Explicit Knowledge characterises tacit knowledge through a number of antonyms: explicit, explicable, and then explicable via elaboration, transformation, mechanization and explanation and, most fundamentally, what can be communicated via ``strings''. But his account blurs the distinction between knowledge and what knowledge can be of and has a number of counter-intuitive consequences. This is the result of his adoption of strings themselves rather than the use of words or signs as the mark of what is explicit and, I suggest, it may stem from his earlier response to Wittgenstein's rules regress.}
}

