@article{ignatow2014ontology-8f9,
  title = {Ontology and Method in Cognitive Sociology},
  author = {Ignatow, Gabriel},
  year = 2014,
  month = dec,
  journal = {Sociological Forum},
  volume = {29},
  number = {4},
